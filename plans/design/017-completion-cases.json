    "mustNotHappen": ["stderr output", "state file creation"]
  },
  {
    "scenario": "future_state_schema",
    "_note": "State written by a newer st: silent empty — the endpoint does not guess at fields it cannot parse.",
    "command": "checkout",
    "words": ["st", "checkout", ""],
    "cursor": 2,
    "setup": { "tracked": ["feat-a"], "trunk": "main", "stateVersion": "future" },
    "expected": [],
