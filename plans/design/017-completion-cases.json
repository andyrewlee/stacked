  },
  {
    "scenario": "thousands_of_branches",
    "_note": "5000 local branches: O(N) output, bounded process count — no per-branch subprocess, no history walk.",
    "command": "track",
    "words": ["st", "track", ""],
    "cursor": 2,
    "setup": { "tracked": ["feat-a"], "trunk": "main", "localUntrackedCount": 5000 },
