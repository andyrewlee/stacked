    "proposed": ["expected"],
    "mustNotHappen": ["stderr output", "nonzero exit"]
  },
  {
    "scenario": "uninitialized_state",
    "_note": "Git repo without st state: silent empty.",
    "command": "checkout",
    "words": ["st", "checkout", ""],
    "cursor": 2,
    "setup": { "gitRepo": true, "initialized": false },
    "expected": [],
