#!/usr/bin/env bash
#
# pre-commit — FAST feedback loop. Runs the cheap checks (formatting, vet,
# lint) plus the sub-second engine tests so obviously-broken changes never get
# committed. The full suite (race tests, e2e, coverage) runs on push via the
# pre-push hook.
#
# Skip with: SKIP_HOOKS=1 git commit ...
#
set -euo pipefail

if [ "${SKIP_HOOKS:-0}" != "0" ]; then
	echo "pre-commit: SKIP_HOOKS set, skipping fast checks"
	exit 0
fi

# Run from the repo root so the Makefile is found.
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: running fast checks (make fmt-check vet lint test-fast)"
if ! make fmt-check vet lint test-fast; then
	echo >&2
	echo "pre-commit: FAILED. Fix the issues above, or bypass with SKIP_HOOKS=1 git commit ..." >&2
	exit 1
fi

echo "pre-commit: OK"
