#!/usr/bin/env bash
#
# pre-commit — FAST feedback loop. Runs the pin-agreement checks (deps, lint,
# go, git, goreleaser — all sub-second), formatting, vet, lint, and the
# sub-second engine tests so obviously-broken changes never get committed.
# The full suite (race tests, e2e, coverage) runs on push via the pre-push
# hook.
#
# Skip with: SKIP_HOOKS=1 git commit ...
#
set -euo pipefail

if [ "${SKIP_HOOKS:-0}" != "0" ]; then
	echo "pre-commit: SKIP_HOOKS set, skipping fast checks"
	exit 0
fi

# Run from the repo root so the Makefile is found.
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: running fast checks (pin agreement + fmt-check vet lint test-fast)"
if ! make check-deps check-lint-version check-go-version check-git-version check-goreleaser-version fmt-check vet lint test-fast; then
	echo >&2
	echo "pre-commit: FAILED. Fix the issues above, or bypass with SKIP_HOOKS=1 git commit ..." >&2
	exit 1
fi

echo "pre-commit: OK"
